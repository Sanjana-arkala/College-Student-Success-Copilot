# ---------- App ----------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# ---------- LLM ----------
ANTHROPIC_API_KEY=your_key_here
LLM_MODEL=claude-sonnet-4-6
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.2

# ---------- Database ----------
DATABASE_URL=postgresql+psycopg2://postgres:password@localhost:5432/college_copilot

# ---------- RAG ----------
CHROMA_PERSIST_DIR=./data/chroma
POLICY_DOCS_DIR=./data/policies
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_TOP_K=4
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100

# ---------- Intervention rules (configurable, FR-11) ----------
MIN_ATTENDANCE_PERCENT=75
MIN_INTERNAL_MARKS_PERCENT=50
MIN_PREVIOUS_GPA=6.0
MAX_ALLOWED_BACKLOGS=1
MAX_INCOMPLETE_ASSIGNMENTS=2
MIN_INDICATORS_FOR_ALERT=2

# ---------- Human approval + audit ----------
REQUIRE_HUMAN_APPROVAL=true
AUDIT_LOG_PATH=./logs/audit.log

# ---------- UI ----------
BACKEND_URL=http://localhost:8000
